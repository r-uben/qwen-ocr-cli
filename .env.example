# Cloud API backend — set ONE of these (auto-detected). Leave unset for local-only use.
# DASHSCOPE_API_KEY=sk-...            # Alibaba DashScope (OpenAI-compatible mode)
# OPENROUTER_API_KEY=sk-or-...        # OpenRouter (model: qwen/qwen3.5-vl-*)

# Self-hosted vLLM backend (e.g. Bocconi HPC). OpenAI-compatible server URL.
# VLLM_BASE_URL=http://localhost:8000/v1

# Optional overrides (else config.py defaults are used)
# QWEN_OCR_OLLAMA_URL=http://localhost:11434/v1
# QWEN_OCR_OLLAMA_MODEL=qwen3-vl
# QWEN_OCR_API_MODEL=qwen3.5-vl-plus
